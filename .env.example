# Server & Network Binding
PORT=3000
HOST=0.0.0.0
MAX_SSE_CLIENTS=150

# Authentication & Security
# Generate a strong random secret in production: openssl rand -hex 32
JWT_SECRET=change-this-in-production
ADMIN_DEFAULT_PASSWORD=change-me-on-first-boot

# Optional Public Maintenance Shield (returns HTTP 503 + Retry-After: 60 on public routes while keeping Back-Office open)
MAINTENANCE_MODE=false

# Optional S3-Compatible Object Storage (Cloudflare R2, MinIO, AWS S3, IDCloudHost IS3)
# Falls back automatically to ./data/uploads when omitted
S3_ENDPOINT=https://s3.example.com
S3_BUCKET=openvolley-media
S3_PREFIX=openvolley
S3_PUBLIC_URL=https://cdn.example.com/openvolley-media
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
S3_REGION=auto
S3_PATH_STYLE=true
